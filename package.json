{
  "name": "crapi-api-tests",
  "version": "1.0.0",
  "description": "Playwright API contract and PostgreSQL persistence tests for OWASP crAPI",
  "scripts": {
    "test": "playwright test --project=api",
    "test:integration": "playwright test --project=integration",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:list"
  },
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "private": true,
  "engines": {
    "node": "26.x"
  }
}
